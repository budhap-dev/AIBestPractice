  "approvalGate": {
    "ask": {
      "title": "The agent asks",
      "body": "It wants to run a command and shows it to you first.",
      "command": "npm test -- auth"
    },
    "check": {
      "title": "You check",
      "body": "Is it the command you expected, on the files you meant?",
      "options": [
        "Allow once",
        "Allow for this session",
        "Deny"
      ]
    },
    "run": {
      "title": "Then it runs",
      "body": "The output goes back into the context, and the agent carries on."
    },
    "bypass": "Global auto-approve removes the gate for every tool. VS Code warns that it disables critical security protections."
  },
  "prefixes": [
    {
      "key": "/",
      "name": "Slash command",
      "does": "Runs an action or a saved prompt",
      "example": "/clear"
    },
    {
      "key": "#",
      "name": "# mention",
      "does": "Attaches exactly the context you name",
      "example": "#problems"
    },
    {
      "key": "@",
      "name": "@ participant",
      "does": "Sends the question to a specialist",
      "example": "@terminal how do I list open ports?"
    }
  ]
